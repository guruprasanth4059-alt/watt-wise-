# WattWise Environment Configuration Example

# Server Port
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=wattwise-secret-jwt-key-development-2026-prod-grade
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Optional: structured fallback heuristic engine operates automatically if omitted)
GEMINI_API_KEY=

# Optional PostgreSQL / Supabase Integration
# (By default, WattWise uses high-performance zero-config embedded SQLite with full relational foreign keys)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
